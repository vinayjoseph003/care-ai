# ================================================================
# Care-AI Environment Configuration Example
# Copy this file to .env and provide your API keys.
# At least one cloud provider key (OpenRouter, Groq, or Gemini)
# is required for full functionality.
# ================================================================

# ── Provider Priority Selection (gemini or openrouter) ─────────────
# Recommended for staging demo: gemini
# Measured local turn latencies (local benchmarks, not guaranteed hosted performance):
#   • Follow-up intake turn: ~2.3s on Gemini (vs ~7.7s on OpenRouter)
#   • Full clinical assessment turn: ~12-18s on Gemini (vs ~35-45s+ on OpenRouter)
#     (executes multi-pass differential reasoning, red-flags, and fact-checking)
LLM_PRIMARY_PROVIDER=gemini

# ── Cloud Provider: OpenRouter (Llama 3.3 70B Instruct) ────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Secondary Cloud Provider: Groq (Fast inference / Llama 3.3 70B) ─
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Tertiary Cloud Provider: Google Gemini (Gemini Flash) ───────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Local Inference Fallback: Ollama ───────────────────────────────
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
